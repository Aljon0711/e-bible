; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="e-bible"
run/main_scene="uid://c2wxon7alfdxq"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

AudioPlayer="*res://Global/audio_player.tscn"
SfxPlayer="*res://Global/sfx_player.tscn"
LevelCore="*res://Scripts/LevelCore.gd"
GameData="*res://Scripts/GameData.gd"
Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
GameManager="*res://GameManager.gd"

[dialogic]

directories/dch_directory={
"God": "res://God.dch",
"Noah": "res://Noah.dch",
"Player": "res://Player.dch",
"Villager": "res://Portraits/Villager.dch",
"Villager2": "res://Portraits/Villager2.dch",
"Wave": "res://Wave.dch"
}
directories/dtl_directory={
"Intro_Story_Mission_1": "res://Intro_Story_Mission_1.dtl",
"Mission 2": "res://Mission 2.dtl",
"Mission_1_Complete": "res://Mission_1_Complete.dtl",
"Mission_2_complete": "res://Mission_2_complete.dtl",
"Mission_3_End": "res://Mission_3_End.dtl",
"Mission_3_inTheArc": "res://Mission_3_inTheArc.dtl",
"Portraits/Mission_3_End": "res://Portraits/Mission_3_End.dtl"
}
layout/style_directory={}
glossary/default_case_sensitive=true

[display]

window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

